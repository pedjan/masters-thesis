LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://localhost:1235/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b
# Optional: set this if LM Studio requires authentication.
# LM_STUDIO_API_KEY=lm-studio

# To use Ollama, set LLM_PROVIDER=ollama and configure:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# To use OpenAI, set LLM_PROVIDER=openai and configure:
# OPENAI_API_KEY=your_api_key
# OPENAI_MODEL=gpt-4o-mini

# Optional when soffice is not on PATH; required for legacy .doc generation.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
